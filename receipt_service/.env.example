# Core
RECEIPT_DB_PATH=receipt_service/data/receipts.db
RECEIPT_PROVIDER=mock
RECEIPT_PROVIDER_TIMEOUT_SECONDS=10

# YooKassa webhook signature
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_SIGNATURE_HEADER=X-YooKassa-Signature
YOOKASSA_REQUIRE_SIGNATURE=false

# YooKassa API access (for sync script)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE=https://api.yookassa.ru/v3
YOOKASSA_START_AT=2026-01-01T00:00:00+03:00
YOOKASSA_TIMEOUT_SECONDS=20
YOOKASSA_LIST_LIMIT=100

# External fiscal provider (existing receipt API mode)
MOY_NALOG_API_URL=
MOY_NALOG_TOKEN=

# NPD sync provider
# mock - no external requests
# http - POST to NPD_SYNC_API_URL (/income and /income/cancel)
NPD_SYNC_PROVIDER=mock
NPD_SYNC_API_URL=
NPD_SYNC_API_TOKEN=
NPD_SYNC_TIMEOUT_SECONDS=20
NPD_SYNC_MAX_ATTEMPTS=20
NPD_SYNC_BATCH_LIMIT=1000

# Incremental sync safety overlap (seconds)
# Worker will read from (last_cursor - lookback)
NPD_SYNC_LOOKBACK_SECONDS=21600

# Production profile example:
# NPD_SYNC_PROVIDER=http
# NPD_SYNC_API_URL=https://partner.example/api
# NPD_SYNC_API_TOKEN=your_token

# Optional thin partner proxy (receipt_service.partner_proxy)
# PROXY_TARGET_BASE_URL=https://actual-partner-api.example
# PROXY_TARGET_INCOME_PATH=/income
# PROXY_TARGET_CANCEL_PATH=/income/cancel
# PROXY_TARGET_TOKEN=
# PROXY_TIMEOUT_SECONDS=20
